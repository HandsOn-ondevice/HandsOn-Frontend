{
  "expo": {
    "name": "HandsOn",
    "slug": "handson-frontend",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "handson",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.handson.frontend",
      "predictiveBackGestureEnabled": true
    },
    "ios": {
      "bundleIdentifier": "com.handson.frontend"
    },
    "web": {
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F1F5FD"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "절차 설명을 녹음하기 위해 마이크를 사용합니다.",
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
